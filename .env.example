NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://voicebridge:voicebridge@localhost:5432/voicebridge?schema=public
JWT_SECRET=replace-with-a-long-random-development-secret
MOCK_AI=true
MOCK_EMAIL=true
MOCK_IVR=true
MOCK_TTS=true
MOCK_EMERGENCY=true
MOCK_IVR_RESPONSE=
CLOSURE_VERIFICATION_MAX_ATTEMPTS=3
STT_PROVIDER=mock
STT_TIMEOUT_MS=180000
INDICWHISPER_ENDPOINT=http://127.0.0.1:8010/transcribe
INDICWHISPER_API_KEY=
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=120000
STT_MIN_CONFIDENCE=0.55
DUPLICATE_WINDOW_MINUTES=60
DUPLICATE_AUTO_MERGE_THRESHOLD=0.90
DUPLICATE_REVIEW_THRESHOLD=0.60
EMERGENCY_TERMS=fire|smoke|gas leak|serious injury|electric shock|chemical leak|explosion
EMERGENCY_CONTACT_EMAIL=
EMERGENCY_RESPONSE_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=voicebridge@example.com
