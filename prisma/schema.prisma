generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  COMPLETED_BY_ASSIGNEE
  OVERDUE
  ESCALATED
  CLOSED
  REPORTER_VERIFICATION_PENDING
  REPORTER_CONFIRMED
  REPORTER_REJECTED
  REOPENED
  EMERGENCY
  AWAITING_CONFIRMATION
  ASSIGNED
  DUPLICATE_MERGED
}

enum VoiceReportStatus {
  RECEIVED
  TRANSCRIBED
  PROCESSING
  NEEDS_CLARIFICATION
  PROCESSED
  FAILED
  VOICE_RECEIVED
  TRANSCRIBING
  EXTRACTION_PENDING
  AWAITING_CONFIRMATION
  SAFETY_CHECK
  DUPLICATE_CHECK
  ASSIGNMENT_PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED_BY_ASSIGNEE
  REPORTER_VERIFICATION_PENDING
  REPORTER_CONFIRMED
  REPORTER_REJECTED
  REOPENED
  OVERDUE
  ESCALATED
  CLOSED
  EMERGENCY
}

enum AudioQuality {
  CLEAN
  NOISY
  UNKNOWN
}

enum VerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum DuplicateReviewStatus {
  PENDING
  MERGED
  DISTINCT
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Department {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  employees   Employee[]
  rules       EscalationRule[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Employee {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               Role           @default(EMPLOYEE)
  jobTitle           String?
  isActive           Boolean        @default(true)
  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId          String?
  manager            Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      Employee[]     @relation("EmployeeManager")
  voiceReports       VoiceReport[]
  closureVerifications ClosureVerification[]
  reportedIncidents  Incident[]     @relation("IncidentReporter")
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  assignments        Assignment[]
  notifications      Notification[]
  escalations        Escalation[]   @relation("EscalationManager")
  auditEvents        AuditLog[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([departmentId, role])
  @@index([managerId])
  @@index([isActive])
}

model VoiceReport {
  id               String            @id @default(cuid())
  reporterId       String
  reporter         Employee          @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  audioPath        String?
  audioMimeType    String?
  durationSeconds  Int?
  transcript       String?
  language         String?
  transcriptionConfidence Float?
  audioQuality     AudioQuality @default(UNKNOWN)
  retryCount       Int          @default(0)
  extraction       Json?
  status           VoiceReportStatus @default(RECEIVED)
  incidentId       String?
  incident         Incident?   @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([incidentId, createdAt])
}

model Incident {
  id                  String         @id @default(cuid())
  incidentNumber      String         @unique
  title               String
  description         String
  abnormality         String?
  asset               String?
  location            String?
  requestedAction     String?
  responsibleDepartment String?
  responsiblePerson   String?
  priority            Priority       @default(MEDIUM)
  status              WorkflowStatus @default(OPEN)
  isEmergency         Boolean        @default(false)
  emergencyStatus     String?
  duplicateGroupId    String?
  duplicateOfIncidentId String?
  duplicateOfIncident Incident? @relation("IncidentDuplicate", fields: [duplicateOfIncidentId], references: [id], onDelete: SetNull)
  duplicateIncidents Incident[] @relation("IncidentDuplicate")
  duplicateReviews    DuplicateReview[] @relation("DuplicateCandidate")
  duplicateOfReviews  DuplicateReview[] @relation("DuplicateExisting")
  reporterVerificationStatus VerificationStatus?
  reporterVerifiedAt  DateTime?
  reopenedAt          DateTime?
  reopenReason        String?
  confidence          Float?
  extractedData       Json?
  missingInformation  String[]       @default([])
  requiresConfirmation Boolean       @default(false)
  deadline            DateTime
  reporterId          String
  reporter            Employee       @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  voiceReports        VoiceReport[]
  tasks               Task[]
  closureVerifications ClosureVerification[]
  emergencyEvents     EmergencyEvent[]
  notifications       Notification[]
  auditEvents         AuditLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, priority])
  @@index([responsibleDepartment, status])
  @@index([reporterId, createdAt])
  @@index([deadline, status])
}

model ClosureVerification {
  id             String             @id @default(cuid())
  incidentId     String
  incident       Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       Employee           @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  status         VerificationStatus @default(PENDING)
  response       String?
  attemptNumber  Int                @default(1)
  evidenceRef    String?
  taskCompletedAt DateTime?
  language       String             @default("hi")
  prompt         String             @default("")
  deliveryMode   String             @default("MOCK")
  deliveryStatus DeliveryStatus     @default(PENDING)
  attemptCount   Int                @default(0)
  lastAttemptAt  DateTime?
  requestedAt    DateTime           @default(now())
  respondedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@index([incidentId, requestedAt])
  @@index([reporterId, status])
  @@index([deliveryStatus, attemptCount, requestedAt])
}

model EmergencyEvent {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind        String
  status      String   @default("PENDING")
  reason      String
  triggeredAt DateTime @default(now())
  alertedAt   DateTime?
  responseDeadline DateTime?
  respondedAt DateTime?
  attemptCount Int @default(0)
  lastAttemptAt DateTime?
  metadata    Json?

  @@index([incidentId, triggeredAt])
  @@index([status, triggeredAt])
}

model DuplicateReview {
  id                String               @id @default(cuid())
  candidateId       String
  candidate         Incident             @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  existingIncidentId String
  existingIncident  Incident             @relation("DuplicateExisting", fields: [existingIncidentId], references: [id], onDelete: Cascade)
  confidence        Float
  status            DuplicateReviewStatus @default(PENDING)
  reason            String
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())

  @@unique([candidateId, existingIncidentId])
  @@index([status, createdAt])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String
  status       WorkflowStatus @default(OPEN)
  deadline     DateTime
  incidentId   String
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     Employee       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    Employee       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments  Assignment[]
  notifications Notification[]
  reminders    Reminder[]
  escalations  Escalation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  completedAt  DateTime?

  @@index([assigneeId, status, deadline])
  @@index([status, deadline])
  @@index([incidentId])
}

model Assignment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason      String
  confidence  Float?
  assignedById String?
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([employeeId, createdAt])
}

model Notification {
  id          String        @id @default(cuid())
  kind        String
  recipientId String?
  recipient   Employee?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject     String
  body        String
  status      DeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  incidentId  String?
  incident    Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([recipientEmail, createdAt])
  @@index([status, createdAt])
  @@index([incidentId, createdAt])
}

model Reminder {
  id          String        @id @default(cuid())
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  sentAt      DateTime?
  status      DeliveryStatus @default(PENDING)
  attemptCount Int @default(0)
  lastAttemptAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, scheduledAt])
  @@index([taskId, status])
}

model Escalation {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  managerId   String
  manager     Employee @relation("EscalationManager", fields: [managerId], references: [id], onDelete: Restrict)
  level       Int      @default(1)
  reason      String
  createdAt   DateTime @default(now())

  @@unique([taskId, level])
  @@index([managerId, createdAt])
}

model EscalationRule {
  id             String     @id @default(cuid())
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  priority       Priority?
  reminderBeforeMinutes Int @default(60)
  escalateAfterMinutes  Int @default(0)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([departmentId, priority, enabled])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  reason     String?
  metadata   Json?
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([incidentId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
