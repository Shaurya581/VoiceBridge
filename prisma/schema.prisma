generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  ESCALATED
  CLOSED
}

enum VoiceReportStatus {
  RECEIVED
  TRANSCRIBED
  PROCESSING
  NEEDS_CLARIFICATION
  PROCESSED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  employees   Employee[]
  rules       EscalationRule[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Employee {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               Role           @default(EMPLOYEE)
  jobTitle           String?
  isActive           Boolean        @default(true)
  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId          String?
  manager            Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      Employee[]     @relation("EmployeeManager")
  voiceReports       VoiceReport[]
  reportedIncidents  Incident[]     @relation("IncidentReporter")
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  assignments        Assignment[]
  notifications      Notification[]
  escalations        Escalation[]   @relation("EscalationManager")
  auditEvents        AuditLog[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([departmentId, role])
  @@index([managerId])
  @@index([isActive])
}

model VoiceReport {
  id               String            @id @default(cuid())
  reporterId       String
  reporter         Employee          @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  audioPath        String?
  audioMimeType    String?
  durationSeconds  Int?
  transcript       String?
  language         String?
  transcriptionConfidence Float?
  extraction       Json?
  status           VoiceReportStatus @default(RECEIVED)
  incident         Incident?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model Incident {
  id                  String         @id @default(cuid())
  incidentNumber      String         @unique
  title               String
  description         String
  abnormality         String?
  asset               String?
  location            String?
  requestedAction     String?
  responsibleDepartment String?
  responsiblePerson   String?
  priority            Priority       @default(MEDIUM)
  status              WorkflowStatus @default(OPEN)
  confidence          Float?
  extractedData       Json?
  missingInformation  String[]       @default([])
  requiresConfirmation Boolean       @default(false)
  deadline            DateTime
  reporterId          String
  reporter            Employee       @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  voiceReportId       String?        @unique
  voiceReport         VoiceReport?   @relation(fields: [voiceReportId], references: [id], onDelete: SetNull)
  tasks               Task[]
  notifications       Notification[]
  auditEvents         AuditLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, priority])
  @@index([responsibleDepartment, status])
  @@index([reporterId, createdAt])
  @@index([deadline, status])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String
  status       WorkflowStatus @default(OPEN)
  deadline     DateTime
  incidentId   String
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     Employee       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    Employee       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments  Assignment[]
  notifications Notification[]
  reminders    Reminder[]
  escalations  Escalation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  completedAt  DateTime?

  @@index([assigneeId, status, deadline])
  @@index([status, deadline])
  @@index([incidentId])
}

model Assignment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason      String
  confidence  Float?
  assignedById String?
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([employeeId, createdAt])
}

model Notification {
  id          String        @id @default(cuid())
  kind        String
  recipientId String?
  recipient   Employee?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject     String
  body        String
  status      DeliveryStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  incidentId  String?
  incident    Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([recipientEmail, createdAt])
  @@index([status, createdAt])
  @@index([incidentId, createdAt])
}

model Reminder {
  id          String        @id @default(cuid())
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  sentAt      DateTime?
  status      DeliveryStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  @@index([status, scheduledAt])
  @@index([taskId, status])
}

model Escalation {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  managerId   String
  manager     Employee @relation("EscalationManager", fields: [managerId], references: [id], onDelete: Restrict)
  level       Int      @default(1)
  reason      String
  createdAt   DateTime @default(now())

  @@unique([taskId, level])
  @@index([managerId, createdAt])
}

model EscalationRule {
  id             String     @id @default(cuid())
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  priority       Priority?
  reminderBeforeMinutes Int @default(60)
  escalateAfterMinutes  Int @default(0)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([departmentId, priority, enabled])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  reason     String?
  metadata   Json?
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([incidentId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
